<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StudentMobile.ViewModels"
             x:Class="StudentMobile.Views.LoginPage">

    <ContentPage.BindingContext>
        <vm:LoginViewModel/>
    </ContentPage.BindingContext>

    <Grid>
        <!-- Background Image -->
        <Image Source="mkmbackground.jpg" 
               Aspect="AspectFill" 
               Opacity="0.3"/>
        
        <!-- Content Overlay -->
        <Grid Padding="20" VerticalOptions="Center" HorizontalOptions="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- MKA Logo -->
            <Image Grid.Row="0" 
                   Source="mka.png" 
                   HeightRequest="400" 
                   WidthRequest="400"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Margin="0,0,0,30"/>
            
            <!-- Login Frame -->
            <Frame Grid.Row="1" 
                   BackgroundColor="White" 
                   CornerRadius="15" 
                   Padding="20" 
                   HasShadow="True"
                   WidthRequest="400">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Frame Grid.Row="0" 
                           BackgroundColor="White" 
                           BorderColor="#E0E0E0" 
                           CornerRadius="20" 
                           Padding="15,12" 
                           HasShadow="False"
                           Margin="0,0,0,15">
                        <Entry x:Name="UsernameEntry"
                               Placeholder="Username" 
                               Text="{Binding Username}"
                               FontSize="16"
                               BackgroundColor="Transparent"/>
                    </Frame>
                    
                    <Frame Grid.Row="1" 
                           BackgroundColor="White" 
                           BorderColor="#E0E0E0" 
                           CornerRadius="20" 
                           Padding="15,12" 
                           HasShadow="False">
                        <Entry x:Name="PasswordEntry"
                               Placeholder="Password" 
                               Text="{Binding Password}" 
                               IsPassword="True"
                               FontSize="16"
                               BackgroundColor="Transparent"/>
                    </Frame>
                    
                    <Button Grid.Row="2" 
                            Text="Forgot Password?" 
                            BackgroundColor="Transparent"
                            TextColor="Blue"
                            HorizontalOptions="End"
                            Margin="0,5,0,0"
                            Clicked="OnForgotPasswordClicked"/>
                    
                    <Button Grid.Row="2" 
                            Text="Login" 
                            BackgroundColor="#181F49"
                            TextColor="White"
                            CornerRadius="10"
                            Margin="0,20,0,0"
                            Clicked="OnLoginClicked"/>
                </Grid>
            </Frame>
        </Grid>
        
        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" 
              BackgroundColor="#80000000" 
              IsVisible="False" 
              ZIndex="1000">
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                <!-- Loading Frame -->
                <Frame x:Name="LoadingFrame"
                       BackgroundColor="White"
                       CornerRadius="15"
                       Padding="20"
                       HasShadow="True"
                       IsVisible="False"
                       WidthRequest="300">
                    <StackLayout Spacing="15">
                        <Image x:Name="LoadingIcon"
                               Source="loading_icon.png"
                               WidthRequest="40"
                               HeightRequest="40"
                               HorizontalOptions="Center"/>
                        <Label x:Name="LoadingMessage" 
                               Text="Logging in..." 
                               TextColor="Black" 
                               FontSize="16"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </StackLayout>
                </Frame>
                
                <!-- Message Frame for Success/Error -->
                <Frame x:Name="MessageFrame"
                       BackgroundColor="White"
                       CornerRadius="15"
                       Padding="20"
                       HasShadow="True"
                       IsVisible="False"
                       WidthRequest="300">
                    <StackLayout Spacing="15">
                        <Image x:Name="MessageIcon"
                               Source="message_icon.png"
                               WidthRequest="40"
                               HeightRequest="40"
                               HorizontalOptions="Center"/>
                        <Label x:Name="MessageText"
                               Text=""
                               TextColor="Black"
                               FontSize="16"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </StackLayout>
                </Frame>
            </StackLayout>
        </Grid>
    </Grid>
</ContentPage>
