<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StudentMobile.ViewModels"
             x:Class="StudentMobile.Views.AttendancePage"
             BackgroundColor="#F8F9FA">

    <ContentPage.BindingContext>
        <vm:AttendanceViewModel/>
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <vm:StatusToColorConverter x:Key="StatusToColorConverter"/>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <StackLayout Padding="20" Spacing="20">
            <!-- Header Section -->
            <Frame BackgroundColor="White" CornerRadius="15" Padding="20" HasShadow="True">
                <StackLayout Spacing="15">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" 
                               Text="My Attendance" 
                               FontSize="24" 
                               FontAttributes="Bold" 
                               VerticalOptions="Center"
                               TextColor="#2C3E50"/>
                        
                        <Grid Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End" WidthRequest="60" HeightRequest="60">
                            <!-- Bell Icon (Using mka.png if bell isn't available) -->
                            <ImageButton Source="mka.png" 
                                         BackgroundColor="Transparent"
                                         WidthRequest="40"
                                         HeightRequest="40"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Command="{Binding ToggleNotificationOverlayCommand}"/>
                            
                            <!-- Red Badge -->
                            <Frame BackgroundColor="Red"
                                   CornerRadius="12"
                                   WidthRequest="24"
                                   HeightRequest="24"
                                   Padding="0"
                                   HorizontalOptions="End"
                                   VerticalOptions="Start"
                                   Margin="0,2,2,0"
                                   IsVisible="{Binding HasUnreadNotifications}"
                                   HasShadow="False">
                                <Label Text="{Binding UnreadNotificationCount}"
                                       TextColor="White"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                        </Grid>
                    </Grid>
                    
                    <!-- Stats Summary -->
                    <Grid ColumnDefinitions="*,*,*" Padding="0,10,0,0">
                        <Frame Grid.Column="0" BackgroundColor="#E8F5E8" CornerRadius="10" Padding="15">
                            <StackLayout>
                                <Label Text="Present" FontSize="12" TextColor="#4CAF50" HorizontalOptions="Center"/>
                                <Label Text="{Binding PresentCount}" FontSize="20" FontAttributes="Bold" TextColor="#4CAF50" HorizontalOptions="Center"/>
                            </StackLayout>
                        </Frame>
                        
                        <Frame Grid.Column="1" BackgroundColor="#FFEBEE" CornerRadius="10" Padding="15">
                            <StackLayout>
                                <Label Text="Absent" FontSize="12" TextColor="#F44336" HorizontalOptions="Center"/>
                                <Label Text="{Binding AbsentCount}" FontSize="20" FontAttributes="Bold" TextColor="#F44336" HorizontalOptions="Center"/>
                            </StackLayout>
                        </Frame>
                        
                        <Frame Grid.Column="2" BackgroundColor="#FFF3E0" CornerRadius="10" Padding="15">
                            <StackLayout>
                                <Label Text="Late" FontSize="12" TextColor="#FF9800" HorizontalOptions="Center"/>
                                <Label Text="{Binding LateCount}" FontSize="20" FontAttributes="Bold" TextColor="#FF9800" HorizontalOptions="Center"/>
                            </StackLayout>
                        </Frame>
                    </Grid>
                </StackLayout>
            </Frame>

            <!-- Attendance Records List -->
            <Frame BackgroundColor="White" CornerRadius="15" HasShadow="True">
                <StackLayout Spacing="15">
                    <Label Text="Attendance History" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="#2C3E50"
                           Margin="0,0,0,10"/>
                    
                    <CollectionView ItemsSource="{Binding AttendanceRecords}" HeightRequest="400">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="#F8F9FA" CornerRadius="10" Padding="0" Margin="0,5" HasShadow="False">
                                    <Grid ColumnDefinitions="5,*" RowDefinitions="Auto">
                                        <!-- Colored Left Bar -->
                                        <BoxView Grid.Column="0" 
                                                 BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}" 
                                                 WidthRequest="5" 
                                                 Margin="0" 
                                                 HorizontalOptions="StartAndExpand" 
                                                 VerticalOptions="FillAndExpand"/>
                                        
                                        <!-- Content Area -->
                                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="15">
                                            <!-- Top Row: Subject and Status -->
                                            <StackLayout Grid.Column="0" Grid.Row="0" VerticalOptions="Center">
                                                <Label Text="{Binding Subject}" 
                                                       FontSize="16" 
                                                       FontAttributes="Bold"
                                                       TextColor="#2C3E50"/>
                                            </StackLayout>
                                            
                                            <StackLayout Grid.Column="1" Grid.Row="0" HorizontalOptions="End" VerticalOptions="Center">
                                                <Frame CornerRadius="20" Padding="10,5" HasShadow="False"
                                                            BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
                                                        <Label Text="{Binding Status}" 
                                                               FontSize="12" 
                                                               FontAttributes="Bold"
                                                               TextColor="White"
                                                               HorizontalOptions="Center"/>
                                                </Frame>
                                            </StackLayout>
                                            
                                            <!-- Bottom Row: Date and Teacher -->
                                            <StackLayout Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Spacing="5" Margin="0,8,0,0">
                                                <StackLayout Orientation="Horizontal" Spacing="10">
                                                    <Label Text="{Binding Date, StringFormat='{0:MMM dd, yyyy}'}" 
                                                           FontSize="14" 
                                                           FontAttributes="Bold"
                                                           TextColor="#666666"/>
                                                </StackLayout>
                                                
                                                <StackLayout Orientation="Horizontal" Spacing="5">
                                                    <Label Text="Teacher:" 
                                                           FontSize="12" 
                                                           FontAttributes="Bold"
                                                           TextColor="#666666"/>
                                                    <Label Text="{Binding TeacherName}" 
                                                           FontSize="12" 
                                                           TextColor="#666666"/>
                                                </StackLayout>
                                            </StackLayout>
                                        </Grid>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </Frame>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                               IsVisible="{Binding IsLoading}"
                               Color="#2C3E50"
                               HeightRequest="40"/>
        </StackLayout>
    </ScrollView>

        <!-- Notification Overlay -->
        <ContentView IsVisible="{Binding IsNotificationOverlayVisible}" BackgroundColor="#80000000" VerticalOptions="Fill" HorizontalOptions="Fill">
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseNotificationOverlayCommand}" />
            </ContentView.GestureRecognizers>
            <Frame BackgroundColor="White" 
                   CornerRadius="15" 
                   Margin="20,60,20,60" 
                   Padding="20" 
                   VerticalOptions="Fill" 
                   HorizontalOptions="Fill"
                   HasShadow="True">
                <!-- Inner Grid absorbs taps so it doesn't close when clicking inside -->
                <Grid RowDefinitions="Auto,*">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer />
                    </Grid.GestureRecognizers>
                    
                    <!-- Overlay Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,15">
                        <Label Grid.Column="0" Text="Notifications" FontSize="20" FontAttributes="Bold" TextColor="#2C3E50" VerticalOptions="Center" />
                        <ImageButton Grid.Column="1" Source="mka.png" WidthRequest="30" HeightRequest="30" CornerRadius="15" Command="{Binding CloseNotificationOverlayCommand}" BackgroundColor="#F8F9FA" />
                    </Grid>

                    <!-- Notifications List -->
                    <CollectionView Grid.Row="1" ItemsSource="{Binding Notifications}">
                        <CollectionView.EmptyView>
                            <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Margin="0,50,0,0">
                                <Label Text="You have no notifications." TextColor="#999999" FontSize="16" HorizontalOptions="Center" />
                            </StackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="#F8F9FA" CornerRadius="10" Padding="15" Margin="0,5" HasShadow="False">
                                    <StackLayout Spacing="5">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" TextColor="#2C3E50" />
                                        <Label Text="{Binding Message}" FontSize="14" TextColor="#666666" />
                                        <Label Text="{Binding CreatedAt, StringFormat='{0:MMM dd, yyyy h:mm tt}'}" FontSize="12" TextColor="#999999" HorizontalOptions="End" />
                                    </StackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Frame>
        </ContentView>
    </Grid>
</ContentPage>
