<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StudentMobile.ViewModels"
             x:Class="StudentMobile.Views.AttendancePage">

    <ContentPage.BindingContext>
        <vm:AttendanceViewModel/>
    </ContentPage.BindingContext>

    <StackLayout Padding="20">
        <Label Text="My Attendance" FontSize="20" HorizontalOptions="Center"/>
        <CollectionView ItemsSource="{Binding AttendanceRecords}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Orientation="Horizontal" Padding="10">
                        <Label Text="{Binding Date, StringFormat='{0:MMM dd, yyyy}'}" WidthRequest="120"/>
                        <Label Text="{Binding Status}" HorizontalOptions="StartAndExpand"/>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"/>
    </StackLayout>
</ContentPage>
