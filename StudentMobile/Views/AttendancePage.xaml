<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StudentMobile.ViewModels"
             x:Class="StudentMobile.Views.AttendancePage"
             BackgroundColor="White">

    <ContentPage.BindingContext>
        <vm:AttendanceViewModel/>
    </ContentPage.BindingContext>

    <ContentPage.Resources>
        <vm:StatusToColorConverter x:Key="StatusToColorConverter"/>
    </ContentPage.Resources>

    <Grid>
        <!-- Colored Background Header -->
        <BoxView BackgroundColor="#181F49" 
                 VerticalOptions="Start" 
                 HorizontalOptions="Fill" 
                 HeightRequest="300"/>
        
        <!-- Main Content -->
        <Grid RowDefinitions="Auto,*">
            <!-- Header Section -->
            <Grid Grid.Row="0" Padding="20" RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" 
                           Text="My Attendance" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           VerticalOptions="Center"
                           TextColor="White"/>
                    
                    <StackLayout Grid.Column="1" Orientation="Horizontal" VerticalOptions="Center" HorizontalOptions="End" Spacing="10">
                        <!-- Student Name -->
                        <Label Text="{Binding StudentName}" 
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="#F0F0F0"
                               VerticalOptions="Center"/>
                        
                        <!-- Notification Icon -->
                        <Grid WidthRequest="60" HeightRequest="60">
                            <!-- Bell Icon -->
                            <ImageButton Source="mka.png" 
                                         BackgroundColor="Transparent"
                                         WidthRequest="30"
                                         HeightRequest="30"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Command="{Binding ToggleNotificationOverlayCommand}"/>
                            
                            <!-- Red Badge -->
                            <Frame BackgroundColor="Red"
                                   CornerRadius="8"
                                   WidthRequest="18"
                                   HeightRequest="18"
                                   Padding="0"
                                   HorizontalOptions="End"
                                   VerticalOptions="Start"
                                   Margin="0,2,2,0"
                                   IsVisible="{Binding HasUnreadNotifications}"
                                   HasShadow="False">
                                <Label Text="{Binding UnreadNotificationCount}"
                                       TextColor="White"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Frame>
                        </Grid>
                    </StackLayout>
                </Grid>
                
                <!-- Stats Summary -->
                <Grid Grid.Row="1" ColumnDefinitions="*,*,*" Padding="0,10,0,0">
                    <Frame Grid.Column="0" BackgroundColor="White" CornerRadius="8" Padding="10">
                        <StackLayout>
                            <Label Text="Present" FontSize="10" TextColor="#4CAF50" HorizontalOptions="Center"/>
                            <Label Text="{Binding PresentCount}" FontSize="16" FontAttributes="Bold" TextColor="#4CAF50" HorizontalOptions="Center"/>
                        </StackLayout>
                    </Frame>
                    
                    <Frame Grid.Column="1" BackgroundColor="White" CornerRadius="8" Padding="10">
                        <StackLayout>
                            <Label Text="Absent" FontSize="10" TextColor="#F44336" HorizontalOptions="Center"/>
                            <Label Text="{Binding AbsentCount}" FontSize="16" FontAttributes="Bold" TextColor="#F44336" HorizontalOptions="Center"/>
                        </StackLayout>
                    </Frame>
                    
                    <Frame Grid.Column="2" BackgroundColor="White" CornerRadius="8" Padding="10">
                        <StackLayout>
                            <Label Text="Late" FontSize="10" TextColor="#FF9800" HorizontalOptions="Center"/>
                            <Label Text="{Binding LateCount}" FontSize="16" FontAttributes="Bold" TextColor="#FF9800" HorizontalOptions="Center"/>
                        </StackLayout>
                    </Frame>
                </Grid>
            </Grid>
            
            <!-- White Content Section -->
            <ScrollView Grid.Row="1">
                <StackLayout Padding="15" Spacing="15">
                    <!-- Attendance Records List -->
                    <Frame BackgroundColor="White" CornerRadius="15" HasShadow="True" Margin="0,20,0,0">
                        <StackLayout Spacing="15">
                            <Label Text="Attendance History" 
                                   FontSize="12" 
                                   FontAttributes="Bold" 
                                   TextColor="#2C3E50"
                                   Margin="0,0,0,5"/>
                            
                            <CollectionView ItemsSource="{Binding AttendanceRecords}" HeightRequest="400">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Frame BackgroundColor="#F8F9FA" CornerRadius="8" Padding="0" Margin="0,3" HasShadow="False">
                                            <Grid ColumnDefinitions="5,*" RowDefinitions="Auto">
                                                <!-- Colored Left Bar -->
                                                <BoxView Grid.Column="0" 
                                                         BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}" 
                                                         WidthRequest="4" 
                                                         Margin="0" 
                                                         HorizontalOptions="StartAndExpand" 
                                                         VerticalOptions="FillAndExpand"/>
                                                
                                                <!-- Content Area -->
                                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="10">
                                                    <!-- Top Row: Subject and Status -->
                                                    <StackLayout Grid.Column="0" Grid.Row="0" VerticalOptions="Center">
                                                        <Label Text="{Binding Subject}" 
                                                               FontSize="14" 
                                                               FontAttributes="Bold"
                                                               TextColor="#2C3E50"/>
                                                    </StackLayout>
                                                    
                                                    <StackLayout Grid.Column="1" Grid.Row="0" HorizontalOptions="End" VerticalOptions="Center">
                                                        <Frame CornerRadius="15" Padding="6,3" HasShadow="False"
                                                                    BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
                                                            <Label Text="{Binding Status}" 
                                                                   FontSize="10" 
                                                                   FontAttributes="Bold"
                                                                   TextColor="White"
                                                                   HorizontalOptions="Center"/>
                                                        </Frame>
                                                    </StackLayout>
                                                    
                                                    <!-- Bottom Row: Date and Teacher -->
                                                    <StackLayout Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Spacing="3" Margin="0,5,0,0">
                                                        <StackLayout Orientation="Horizontal" Spacing="8">
                                                            <Label Text="{Binding Date, StringFormat='{0:MMM dd, yyyy}'}" 
                                                                   FontSize="12" 
                                                                   FontAttributes="Bold"
                                                                   TextColor="#666666"/>
                                                        </StackLayout>
                                                        
                                                        <StackLayout Orientation="Horizontal" Spacing="3">
                                                            <Label Text="Teacher:" 
                                                                   FontSize="10" 
                                                                   FontAttributes="Bold"
                                                                   TextColor="#666666"/>
                                                            <Label Text="{Binding TeacherName}" 
                                                                   FontSize="10" 
                                                                   TextColor="#666666"/>
                                                        </StackLayout>
                                                    </StackLayout>
                                                </Grid>
                                            </Grid>
                                        </Frame>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </StackLayout>
                    </Frame>
                    
                    <!-- Extra white space at bottom -->
                    <BoxView HeightRequest="100" BackgroundColor="Transparent"/>
                    
                    <!-- Loading Indicator -->
                    <ActivityIndicator IsRunning="{Binding IsLoading}" 
                                       IsVisible="{Binding IsLoading}"
                                       Color="#2C3E50"
                                       HeightRequest="40"/>
                </StackLayout>
            </ScrollView>
        </Grid>

        <!-- Notification Overlay -->
        <ContentView IsVisible="{Binding IsNotificationOverlayVisible}" BackgroundColor="#80000000" VerticalOptions="Fill" HorizontalOptions="Fill">
            <ContentView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseNotificationOverlayCommand}" />
            </ContentView.GestureRecognizers>
            <Frame BackgroundColor="White" 
                   CornerRadius="20" 
                   Margin="25,80,25,80" 
                   Padding="0" 
                   VerticalOptions="Fill" 
                   HorizontalOptions="Fill"
                   HasShadow="True">
                <!-- Inner Grid absorbs taps so it doesn't close when clicking inside -->
                <Grid RowDefinitions="Auto,*">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer />
                    </Grid.GestureRecognizers>
                    
                    <!-- Blue Background Header with Enhanced Design -->
                    <Grid Grid.Row="0" HeightRequest="80">
                        <BoxView BackgroundColor="#181F49" 
                                 VerticalOptions="Fill" 
                                 HorizontalOptions="Fill"/>
                        
                        <!-- Header Content -->
                        <Grid ColumnDefinitions="*,Auto" Margin="25,0" VerticalOptions="Center">
                            <StackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="Notifications" FontSize="22" FontAttributes="Bold" TextColor="White" />
                                <Label Text="{Binding UnreadNotificationCount, StringFormat='You have {0} new notifications'}" 
                                       FontSize="12" TextColor="#B0BEC5" IsVisible="{Binding HasUnreadNotifications}"/>
                            </StackLayout>
                            
                            <Frame Grid.Column="1" 
                                   BackgroundColor="White" 
                                   CornerRadius="25" 
                                   WidthRequest="50" 
                                   HeightRequest="50" 
                                   Padding="8"
                                   HasShadow="True">
                                <Image Source="mka.png" 
                                      Aspect="AspectFit" 
                                      HorizontalOptions="Center" 
                                      VerticalOptions="Center">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding CloseNotificationOverlayCommand}" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </Frame>
                        </Grid>
                    </Grid>

                    <!-- Notifications List with Clean Design -->
                    <ScrollView Grid.Row="1">
                        <CollectionView ItemsSource="{Binding Notifications}" Margin="20,20,20,20">
                            <CollectionView.EmptyView>
                                <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Margin="0,50,0,50">
                                    <Frame BackgroundColor="#F5F7FA" CornerRadius="50" Padding="20" WidthRequest="80" HeightRequest="80" HasShadow="False">
                                        <Label Text="📬" FontSize="30" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Frame>
                                    <Label Text="No notifications yet" TextColor="#64748B" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,10,0,5"/>
                                    <Label Text="You'll see your notifications here" TextColor="#94A3B8" FontSize="14" HorizontalOptions="Center"/>
                                </StackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame BackgroundColor="#F8FAFB" 
                                           CornerRadius="12" 
                                           Padding="18" 
                                           Margin="0,8" 
                                           HasShadow="True"
                                           BorderColor="#E2E8F0">
                                        <StackLayout Spacing="8">
                                            <!-- Title and Date -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label Grid.Column="0"
                                                       Text="{Binding Title}" 
                                                       FontAttributes="Bold" 
                                                       FontSize="16" 
                                                       TextColor="#1E293B" 
                                                       HorizontalOptions="StartAndExpand"/>
                                                <Label Grid.Column="1"
                                                       Text="{Binding CreatedAt, StringFormat='{0:MMM dd, yyyy}'}" 
                                                       FontSize="12" 
                                                       TextColor="#94A3B8" 
                                                       VerticalOptions="Center"/>
                                            </Grid>
                                            
                                            <!-- Message -->
                                            <Label Text="{Binding Message}" 
                                                   FontSize="14" 
                                                   TextColor="#475569" 
                                                   LineBreakMode="WordWrap"/>
                                            
                                            <!-- Time -->
                                            <Label Text="{Binding CreatedAt, StringFormat='{0:h:mm tt}'}" 
                                                   FontSize="11" 
                                                   TextColor="#94A3B8" 
                                                   HorizontalOptions="End"/>
                                        </StackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </ScrollView>
                </Grid>
            </Frame>
        </ContentView>
    </Grid>
</ContentPage>
