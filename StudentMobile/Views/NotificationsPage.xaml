<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StudentMobile.ViewModels"
             x:Class="StudentMobile.Views.NotificationsPage"
             BackgroundColor="#F8F9FA"
             Title="Notifications">

    <ContentPage.BindingContext>
        <vm:NotificationsViewModel/>
    </ContentPage.BindingContext>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Mark All Read" Command="{Binding MarkAllAsReadCommand}"/>
        <ToolbarItem Text="Clear All" Command="{Binding ClearAllCommand}"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">
            <!-- Header -->
            <Frame BackgroundColor="White" CornerRadius="15" Padding="20" HasShadow="True">
                <StackLayout Spacing="10">
                    <Label Text="Notifications" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="#2C3E50"
                           HorizontalOptions="Center"/>
                    
                    <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="20">
                        <Frame BackgroundColor="#FF5252" CornerRadius="20" Padding="10,5" HasShadow="False">
                            <Label Text="{Binding UnreadCount}" 
                                   FontSize="14" 
                                   TextColor="White"
                                   FontAttributes="Bold"/>
                        </Frame>
                        <Label Text="Unread" 
                               FontSize="14" 
                               TextColor="#666666"
                               VerticalOptions="Center"/>
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- Notifications List -->
            <CollectionView ItemsSource="{Binding Notifications}" HeightRequest="500">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="White" 
                               CornerRadius="10" 
                               Padding="15" 
                               Margin="0,5"
                               HasShadow="True">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                                <!-- Icon -->
                                <Image Grid.Row="0" 
                                       Grid.Column="0" 
                                       Source="{Binding Icon}"
                                       WidthRequest="40" 
                                       HeightRequest="40"
                                       VerticalOptions="Start"
                                       Margin="0,0,15,0"/>
                                
                                <!-- Content -->
                                <StackLayout Grid.Row="0" Grid.Column="1" Spacing="5">
                                    <Label Text="{Binding Title}" 
                                           FontSize="16" 
                                           FontAttributes="Bold"
                                           TextColor="#2C3E50"/>
                                    <Label Text="{Binding Message}" 
                                           FontSize="14" 
                                           TextColor="#666666"
                                           LineBreakMode="WordWrap"/>
                                    <Label Text="{Binding DateDisplay}" 
                                           FontSize="12" 
                                           TextColor="#999999"/>
                                </StackLayout>
                                
                                <!-- Status Indicator -->
                                <Frame Grid.Row="0" 
                                       Grid.Column="2" 
                                       BackgroundColor="{Binding Color}"
                                       CornerRadius="20" 
                                       Padding="8,4" 
                                       HasShadow="False"
                                       IsVisible="{Binding IsRead, Converter={StaticResource InverseBoolConverter}}">
                                    <Label Text="New" 
                                           FontSize="10" 
                                           TextColor="White"
                                           FontAttributes="Bold"/>
                                </Frame>
                                
                                <!-- Mark as Read Button -->
                                <Button Grid.Row="1" 
                                        Grid.Column="1" 
                                        Grid.ColumnSpan="2"
                                        Text="Mark as Read" 
                                        BackgroundColor="#4CAF50"
                                        TextColor="White"
                                        CornerRadius="20"
                                        HorizontalOptions="End"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.MarkAsReadCommand}"
                                        CommandParameter="{Binding .}"
                                        IsVisible="{Binding IsRead, Converter={StaticResource InverseBoolConverter}}"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Empty State -->
            <StackLayout IsVisible="{Binding HasNoNotifications}" 
                        HorizontalOptions="Center" 
                        VerticalOptions="Center" 
                        Spacing="20">
                <Image Source="no_notifications.png" 
                       WidthRequest="100" 
                       HeightRequest="100"/>
                <Label Text="No notifications" 
                       FontSize="18" 
                       TextColor="#666666"
                       HorizontalOptions="Center"/>
                <Label Text="You're all caught up!" 
                       FontSize="14" 
                       TextColor="#999999"
                       HorizontalOptions="Center"/>
            </StackLayout>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                               IsVisible="{Binding IsLoading}"
                               Color="#2C3E50"
                               HeightRequest="40"/>
        </StackLayout>
    </ScrollView>
</ContentPage>
