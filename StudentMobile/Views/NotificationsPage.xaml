<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StudentMobile.ViewModels"
             x:Class="StudentMobile.Views.NotificationsPage"
             BackgroundColor="#F8F9FA"
             Title="Attendance Notifications">

    <ContentPage.BindingContext>
        <vm:NotificationsViewModel/>
    </ContentPage.BindingContext>

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">
            <!-- Header -->
            <Frame BackgroundColor="White" CornerRadius="15" Padding="20" HasShadow="True">
                <StackLayout Spacing="10">
                    <Label Text="Attendance Notifications" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="#2C3E50"
                           HorizontalOptions="Center"/>
                    
                    <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="20">
                        <Frame BackgroundColor="#FF5252" CornerRadius="20" Padding="10,5" HasShadow="False">
                            <Label Text="{Binding UnreadCount}" 
                                   FontSize="14" 
                                   TextColor="White"
                                   FontAttributes="Bold"/>
                        </Frame>
                        <Label Text="New Updates" 
                               FontSize="14" 
                               TextColor="#666666"
                               VerticalOptions="Center"/>
                    </StackLayout>
                </StackLayout>
            </Frame>

            <!-- Notifications List -->
            <CollectionView ItemsSource="{Binding Notifications}" HeightRequest="400">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="White" 
                               CornerRadius="10" 
                               Padding="15" 
                               Margin="0,5"
                               HasShadow="True">
                            <StackLayout Spacing="10">
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                    <!-- Icon -->
                                    <Label Grid.Row="0" 
                                           Grid.Column="0" 
                                           Text="📋" 
                                           FontSize="20"
                                           VerticalOptions="Start"
                                           Margin="0,0,15,0"/>
                                    
                                    <!-- Content -->
                                    <StackLayout Grid.Row="0" Grid.Column="1" Spacing="5">
                                        <Label Text="{Binding Title}" 
                                               FontSize="16" 
                                               FontAttributes="Bold"
                                               TextColor="#2C3E50"/>
                                        <Label Text="{Binding Message}" 
                                               FontSize="14" 
                                               TextColor="#666666"
                                               LineBreakMode="WordWrap"/>
                                        <Label Text="{Binding DateDisplay}" 
                                               FontSize="12" 
                                               TextColor="#999999"/>
                                    </StackLayout>
                                </Grid>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Empty State -->
            <StackLayout IsVisible="{Binding HasNoNotifications}" 
                        HorizontalOptions="Center" 
                        VerticalOptions="Center" 
                        Spacing="20">
                <Label Text="📋" 
                       FontSize="60" 
                       TextColor="#CCCCCC"
                       HorizontalOptions="Center"/>
                <Label Text="No new notifications" 
                       FontSize="18" 
                       TextColor="#666666"
                       HorizontalOptions="Center"/>
                <Label Text="Check back later for attendance updates" 
                       FontSize="14" 
                       TextColor="#999999"
                       HorizontalOptions="Center"/>
            </StackLayout>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                               IsVisible="{Binding IsLoading}"
                               Color="#2C3E50"
                               HeightRequest="40"/>
        </StackLayout>
    </ScrollView>
</ContentPage>
