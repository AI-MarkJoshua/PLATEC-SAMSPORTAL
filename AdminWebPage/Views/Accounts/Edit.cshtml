@model AdminWebPage.Shared.Models.Account
@inject AdminWebPage.Shared.Data.AdminWebPageContext _context
@using System.Linq
@using Microsoft.EntityFrameworkCore

@{
    ViewData["Title"] = "Edit Account";
    var userRole = Context.Session.GetString("UserRole");
}

<h2 class="mb-4">Edit Account</h2>

<div class="row justify-content-center">
    <div class="col-md-8">

        <form asp-action="Edit" class="bg-white p-4 rounded-20 shadow-sm">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="AccountID" />

            <!-- ================= PERSONAL INFORMATION ================= -->
            <h5 class="mb-3 text-secondary">Personal Information</h5>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="FName" class="form-label">First Name</label>
                    <input asp-for="FName" class="form-control rounded-20" />
                    <span asp-validation-for="FName" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="MName" class="form-label">Middle Name</label>
                    <input asp-for="MName" class="form-control rounded-20" />
                    <span asp-validation-for="MName" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="LName" class="form-label">Last Name</label>
                    <input asp-for="LName" class="form-control rounded-20" />
                    <span asp-validation-for="LName" class="text-danger"></span>
                </div>
            </div>

            <!-- ================= ACCOUNT CREDENTIALS ================= -->
            <h5 class="mb-3 text-secondary">Account Credentials</h5>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Username" class="form-label">Username</label>
                    <input asp-for="Username" class="form-control rounded-20" readonly />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" class="form-control rounded-20" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
            </div>

            <!-- Generate Button (only for Student accounts) -->
            @if (Model.Role == "Student")
            {
                <div class="mb-4">
                    <button type="button"
                            class="btn btn-outline-primary rounded-20"
                            onclick="generateAccount()">
                        Generate Student Account
                    </button>
                    <small class="text-muted ms-2">
                        Automatically generates username & password
                    </small>
                </div>
            }

            <!-- ================= OTHER DETAILS ================= -->
            <h5 class="mb-3 text-secondary">Other Details</h5>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control rounded-20" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Role" class="form-label">Role</label>
                    <select asp-for="Role" class="form-select rounded-20" id="roleSelect">
                        <option value="">-- Select Role --</option>
                        
                        @if (userRole == "Admin" || userRole == "Student")
                        {
                            <option value="Admin">Admin</option>
                        }
                        
                        @if (userRole == "Admin" || userRole == "Student")
                        {
                            <option value="Teacher">Teacher</option>
                        }
                        
                        <option value="Student">Student</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
            </div>
            
            <!-- Teacher Assignment Section (only for Admin editing Student) -->
            <div id="teacherAssignmentSection" class="col-md-12" style="display: none;">
                <h5 class="mb-3 text-secondary">Assign to Teacher</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-12">
                        <label class="form-label">Select Teacher (Optional)</label>
                        <select id="teacherSelect" class="form-select rounded-20" name="selectedTeacherId">
                            <option value="">-- No Teacher (Unassigned) --</option>
                            @{
                                var teachers = await _context.Accounts
                                    .Where(a => a.Role == "Teacher")
                                    .OrderBy(a => a.LName)
                                    .ThenBy(a => a.FName)
                                    .ToListAsync();
                                
                                foreach (var teacher in teachers)
                                {
                                    var isSelected = Model.TeacherID == teacher.AccountID;
                                    <option value="@teacher.AccountID" selected="@isSelected">@teacher.FName @teacher.LName (@teacher.Username)</option>
                                }
                            }
                        </select>
                        <small class="text-muted d-block mt-1">
                            Assign this student to a teacher for supervision. Leave unassigned if not needed.
                        </small>
                    </div>
                </div>
            </div>
            
            <!-- Subject Assignment Section (for Admin editing Teacher or Student) -->
            <div id="sectionAssignmentSection" class="col-md-12" style="display: none;">
                <h5 class="mb-3 text-secondary">Assign to Subject</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-12">
                        <label class="form-label">Select Subject</label>
                        <select id="sectionSelect" class="form-select rounded-20" name="selectedSectionId">
                            <option value="">-- No Subject (Unassigned) --</option>
                            @{
                                List<Section> sections;
                                if (userRole == "Teacher")
                                {
                                    // Teacher can only assign students to their assigned sections
                                    var teacherId = Context.Session.GetInt32("AccountID");
                                    sections = await _context.TeacherSections
                                        .Where(ts => ts.TeacherID == teacherId)
                                        .Include(ts => ts.Section)
                                        .Select(ts => ts.Section)
                                        .OrderBy(s => s.SectionName)
                                        .ToListAsync();
                                }
                                else
                                {
                                    // Admin and Student can see all sections
                                    sections = await _context.Sections
                                        .OrderBy(s => s.SectionName)
                                        .ToListAsync();
                                }
                                
                                foreach (var sectionItem in sections)
                                {
                                    var isSelected = Model.SectionID == sectionItem.SectionID;
                                    <option value="@sectionItem.SectionID" selected="@isSelected" data-teacher-sections="@string.Join(",", await _context.TeacherSections.Where(ts => ts.SectionID == sectionItem.SectionID).Select(ts => ts.TeacherID.ToString()).ToListAsync())">@sectionItem.SectionName</option>
                                }
                            }
                        </select>
                        <small class="text-muted d-block mt-1">
                            Assign to a subject for organization. Subjects are filtered based on selected teacher.
                        </small>
                    </div>
                </div>
            </div>
            
            <!-- Teacher Section Assignment (only for Admin editing Teacher) -->
            <div id="teacherSectionAssignmentSection" class="col-md-12" style="display: none;">
                <h5 class="mb-3 text-secondary">Assign Teacher to Subjects</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-12">
                        <label class="form-label">Select Subjects for this Teacher</label>
                        <div class="border rounded-20 p-3" style="max-height: 200px; overflow-y: auto;">
                            @{
                                var allSections = await _context.Sections
                                    .OrderBy(s => s.SectionName)
                                    .ToListAsync();
                                
                                // Get current teacher's assigned sections
                                var currentTeacherSections = new HashSet<int>();
                                if (Model.Role == "Teacher")
                                {
                                    var assignedSectionIds = await _context.TeacherSections
                                        .Where(ts => ts.TeacherID == Model.AccountID)
                                        .Select(ts => ts.SectionID)
                                        .ToListAsync();
                                    currentTeacherSections = new HashSet<int>(assignedSectionIds);
                                }
                                
                                foreach (var sectionItem in allSections)
                                {
                                    var isChecked = currentTeacherSections.Contains(sectionItem.SectionID);
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" 
                                               name="selectedSectionIds" value="@sectionItem.SectionID" 
                                               id="section_@sectionItem.SectionID" checked="@isChecked">
                                        <label class="form-check-label" for="section_@sectionItem.SectionID">
                                            @sectionItem.SectionName
                                        </label>
                                    </div>
                                }
                            }
                        </div>
                        <small class="text-muted d-block mt-1">
                            Select all subjects this teacher will manage. Teachers can only see students in their assigned subjects.
                        </small>
                    </div>
                </div>
            </div>

            <!-- ================= ACTION BUTTONS ================= -->
            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index"
                   class="btn btn-light rounded-20">
                    Cancel
                </a>

                <button type="submit"
                        class="btn text-white rounded-20"
                        style="background-color:#20274a;">
                    Save Changes
                </button>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Show/hide assignment sections based on role and selected role
        document.getElementById('roleSelect').addEventListener('change', function() {
            const selectedRole = this.value;
            const teacherSection = document.getElementById('teacherAssignmentSection');
            const sectionSection = document.getElementById('sectionAssignmentSection');
            const teacherSectionSection = document.getElementById('teacherSectionAssignmentSection');
            const userRole = '@userRole';
            
            // Hide all sections first
            teacherSection.style.display = 'none';
            sectionSection.style.display = 'none';
            teacherSectionSection.style.display = 'none';
            
            if (userRole === 'Admin') {
                if (selectedRole === 'Student') {
                    // Admin editing Student: show teacher assignment and section assignment
                    teacherSection.style.display = 'block';
                    sectionSection.style.display = 'block';
                } else if (selectedRole === 'Teacher') {
                    // Admin editing Teacher: show teacher section assignment
                    teacherSectionSection.style.display = 'block';
                }
            } else if (userRole === 'Teacher') {
                // Teacher editing Student: show section assignment (auto-assigned to teacher's sections)
                if (selectedRole === 'Student') {
                    sectionSection.style.display = 'block';
                    // Load teacher's sections
                    loadTeacherSections();
                }
            } else if (userRole === 'Student') {
                // Student editing Student: show section assignment (optional)
                if (selectedRole === 'Student') {
                    sectionSection.style.display = 'block';
                }
            }
        });

        // Filter sections based on selected teacher
        document.getElementById('teacherSelect')?.addEventListener('change', function() {
            const selectedTeacherId = this.value;
            const sectionSelect = document.getElementById('sectionSelect');
            
            if (selectedTeacherId) {
                // Filter sections to show only those assigned to the selected teacher
                const options = sectionSelect.querySelectorAll('option');
                options.forEach(option => {
                    if (option.value !== '') {
                        const teacherSections = option.getAttribute('data-teacher-sections');
                        if (teacherSections) {
                            const teacherIds = teacherSections.split(',');
                            option.style.display = teacherIds.includes(selectedTeacherId) ? 'block' : 'none';
                        } else {
                            option.style.display = 'none';
                        }
                    }
                });
                
                // Reset section selection if current selection is not available
                const currentSelection = sectionSelect.value;
                if (currentSelection && sectionSelect.querySelector(`option[value="${currentSelection}"]`).style.display === 'none') {
                    sectionSelect.value = '';
                }
            } else {
                // Show all sections when no teacher is selected
                const options = sectionSelect.querySelectorAll('option');
                options.forEach(option => option.style.display = 'block');
            }
        });

        // Load teacher's sections for section dropdown
        function loadTeacherSections() {
            const sectionSelect = document.getElementById('sectionSelect');
            // This would be implemented to load only the teacher's assigned sections
            // For now, we'll show all sections
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            const roleSelect = document.getElementById('roleSelect');
            if (roleSelect) {
                roleSelect.dispatchEvent(new Event('change'));
            }
            
            // Trigger teacher change event to filter sections
            const teacherSelect = document.getElementById('teacherSelect');
            if (teacherSelect) {
                teacherSelect.dispatchEvent(new Event('change'));
            }
        });

        function generateAccount() {
            fetch('/Accounts/GenerateStudentAccount')
                .then(res => res.json())
                .then(data => {
                    document.getElementById('Username').value = data.username;
                    document.getElementById('Password').value = data.password;
                })
                .catch(() => alert("Failed to generate account."));
        }
    </script>
}
