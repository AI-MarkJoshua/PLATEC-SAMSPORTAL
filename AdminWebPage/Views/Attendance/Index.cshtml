@model List<AdminWebPage.Shared.Models.Account>

@{
    var attendanceMap = ViewBag.AttendanceMap as Dictionary<int, string> ?? new();
    var userRole = Context.Session.GetString("UserRole");
    var justSaved = TempData["JustSavedAttendance"]?.ToString() == "true";
}

<h2 class="mb-3">Mark Attendance</h2>

<form method="get" class="mb-4 bg-white p-3 rounded shadow-sm" id="attendanceFilterForm">
    <div class="row g-3">
        @if (userRole == "Admin")
        {
            <div class="col-md-3">
                <label class="form-label">Select Teacher</label>
                <select name="selectedTeacherId" class="form-select" id="teacherSelect">
                    <option value="">-- All Teachers --</option>
                    @if (ViewBag.Teachers != null)
                    {
                        @foreach (var teacher in ViewBag.Teachers)
                        {
                            var isSelected = ViewBag.SelectedTeacherId?.ToString() == teacher.AccountID.ToString();
                            <option value="@teacher.AccountID" selected="@isSelected">@teacher.FName @teacher.LName (@teacher.Username)</option>
                        }
                    }
                </select>
            </div>
        }
        
        <div class="@(userRole == "Admin" ? "col-md-3" : "col-md-4")">
            <label class="form-label">Select Subject</label>
            <select name="selectedSectionId" class="form-select" id="subjectSelect">
                <option value="">-- All Subjects --</option>
                @if (ViewBag.TeacherSections != null)
                {
                    @foreach (var sectionItem in ViewBag.TeacherSections)
                    {
                        var isSelected = ViewBag.SelectedSectionId?.ToString() == sectionItem.SectionID.ToString();
                        <option value="@sectionItem.SectionID" selected="@isSelected" data-teacher-id="@sectionItem.TeacherID">@sectionItem.Section.SectionName</option>
                    }
                }
            </select>
        </div>
        
        <div class="@(userRole == "Admin" ? "col-md-3" : "col-md-4")">
            <label class="form-label">Select Attendance Date</label>
            <input type="date"
                   name="selectedDate"
                   value="@ViewBag.SelectedDate?.ToString("yyyy-MM-dd")"
                   class="form-control"
                   required />
        </div>
        
        <div class="@(userRole == "Admin" ? "col-md-3" : "col-md-4")">
            <label class="form-label">&nbsp;</label>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-load-students">Load Students</button>
                <a href="/Attendance/Index" class="btn btn-outline-secondary">Clear Filters</a>
            </div>
        </div>
    </div>
</form>

@if (ViewBag.AttendanceByDateAndSection != null)
{
  <div class="bg-white p-4 rounded shadow-sm mt-4">
    <h5 class="mb-3">Attendance History</h5>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Teacher</th>
                    <th>Subject</th>
                    <th>Total Students</th>
                    <th class="text-center">Present</th>
                    <th class="text-center">Absent</th>
                    <th class="text-center">Late</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var attendanceByDateAndSection = ViewBag.AttendanceByDateAndSection;
                }
                @foreach (var entry in attendanceByDateAndSection)
                {
                    var key = entry.Key;
                    var date = key.Date;
                    var sectionName = key.SectionName;
                    var sectionId = key.SectionId;
                    var teacherName = key.TeacherName ?? "Unknown";
                    var attendanceData = entry.Value as Dictionary<int, string>;

                    int present = attendanceData.Count(x => x.Value == "Present");
                    int absent = attendanceData.Count(x => x.Value == "Absent");
                    int late = attendanceData.Count(x => x.Value == "Late");
                    int totalStudents = attendanceData.Count;

                    <tr>
                        <td>@date.ToString("MMM dd, yyyy")</td>
                        <td>@teacherName</td>
                        <td>@sectionName</td>
                        <td>@totalStudents</td>
                        <td class="text-center">
                            <span class="badge bg-success">@present</span>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-danger">@absent</span>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-warning text-dark">@late</span>
                        </td>
                        <td class="text-center">
                            <button type="button" 
                                    class="btn btn-sm btn-outline-primary view-attendance-btn" 
                                    data-date="@date.ToString("yyyy-MM-dd")"
                                    data-section-id="@sectionId"
                                    data-bs-toggle="modal" 
                                    data-bs-target="#attendanceDetailsModal">
                                View
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
  </div>
}

@if (ViewBag.SelectedDate != null)
{
    <!-- Modal -->
    <div class="modal fade" id="attendanceModal" tabindex="-1" aria-labelledby="attendanceModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="attendanceModalLabel">Mark Attendance - @ViewBag.SelectedDate?.ToString("yyyy-MM-dd")</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    @if (Model.Any())
                    {
                        <form id="attendanceForm">
                            @Html.AntiForgeryToken()

                            <table class="table table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Student Name</th>
                                        <th class="text-center">Attendance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var student in Model)
                                    {
                                        var status = attendanceMap.ContainsKey(student.AccountID)
                                        ? attendanceMap[student.AccountID]
                                        : "";

                                        <tr>
                                            <td>@student.FName @student.LName</td>
                                            <td class="text-center">
                                                <div class="d-inline-flex gap-2">
                                                    <button type="button"
                                                            class="btn attendance-btn @(status == "Present" ? "active" : "")"
                                                            data-student="@student.AccountID"
                                                            data-status="Present"
                                                            style="@(status == "Present" ? "background-color: #20274a; border-color: #20274a; color: white;" : "border-color: #20274a; color: #20274a;")">
                                                        Present
                                                    </button>

                                                    <button type="button"
                                                            class="btn attendance-btn @(status == "Absent" ? "active" : "")"
                                                            data-student="@student.AccountID"
                                                            data-status="Absent"
                                                            style="@(status == "Absent" ? "background-color: #20274a; border-color: #20274a; color: white;" : "border-color: #20274a; color: #20274a;")">
                                                        Absent
                                                    </button>

                                                    <button type="button"
                                                            class="btn attendance-btn @(status == "Late" ? "active" : "")"
                                                            data-student="@student.AccountID"
                                                            data-status="Late"
                                                            style="@(status == "Late" ? "background-color: #20274a; border-color: #20274a; color: white;" : "border-color: #20274a; color: #20274a;")">
                                                        Late
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </form>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <p>No students found for the selected criteria.</p>
                            <p>Please try selecting a different teacher, subject, or date.</p>
                        </div>
                    }
                </div>

                <div class="modal-footer">
                    @if (Model.Any())
                    {
                        <button type="button" class="btn" id="saveAttendanceBtn" style="background-color: #20274a; border-color: #20274a; color: white;">Save Attendance</button>
                    }
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" style="border-color: #6c757d; color: #6c757d;" onmouseover="this.style.backgroundColor='#6c757d'; this.style.color='white';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#6c757d';">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Attendance Details Modal -->
<div class="modal fade" id="attendanceDetailsModal" tabindex="-1" aria-labelledby="attendanceDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="attendanceDetailsModalLabel">Attendance Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="attendanceDetailsContent">
                    <div class="text-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    const attendanceState = {}; // Track selected status

    // Filter subjects based on teacher selection (for admin)
    document.getElementById('teacherSelect')?.addEventListener('change', function() {
        const selectedTeacherId = this.value;
        const subjectSelect = document.getElementById('subjectSelect');
        
        // Get all subject options
        const options = subjectSelect.querySelectorAll('option');
        
        options.forEach(option => {
            if (option.value === '') {
                // Keep the "All Subjects" option visible
                option.style.display = 'block';
            } else {
                const teacherId = option.getAttribute('data-teacher-id');
                if (selectedTeacherId === '') {
                    // If "All Teachers" is selected, show all subjects
                    option.style.display = 'block';
                } else {
                    // Only show subjects belonging to selected teacher
                    option.style.display = teacherId === selectedTeacherId ? 'block' : 'none';
                }
            }
        });
        
        // Reset subject selection if current selection is not visible
        const currentSelection = subjectSelect.value;
        if (currentSelection && subjectSelect.querySelector(`option[value="${currentSelection}"]`).style.display === 'none') {
            subjectSelect.value = '';
        }
    });

    // Initialize button click
    document.querySelectorAll('.attendance-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            const studentId = this.dataset.student;
            const status = this.dataset.status;
            const parent = this.parentElement;

            // Remove active classes from siblings
            parent.querySelectorAll('.attendance-btn').forEach(b => {
                b.classList.remove('active');
                b.style.backgroundColor = 'transparent';
                b.style.color = '#20274a';
                b.style.borderColor = '#20274a';
            });

            // Apply active style to clicked button
            this.classList.add('active');
            this.style.backgroundColor = '#20274a';
            this.style.color = 'white';
            this.style.borderColor = '#20274a';

            // Save locally in JS
            attendanceState[studentId] = status;
        });
    });

    // Save Attendance button
       // Save Attendance button
    document.getElementById('saveAttendanceBtn')?.addEventListener('click', function () {
        const date = document.querySelector('input[name="selectedDate"]').value;
        const token = document.querySelector('#attendanceForm input[name="__RequestVerificationToken"]').value;

        const payloads = Object.entries(attendanceState).map(([studentId, status]) => ({
            studentId: parseInt(studentId),
            status: status,
            date: date
        }));

        if (payloads.length === 0) {
            alert("No attendance selected!");
            return; // Do not close modal
        }

        fetch('/Attendance/MarkAll', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify(payloads)
        })
        .then(res => {
            if (res.ok) {
                alert('Attendance saved successfully!');
                // Update local state
                payloads.forEach(p => attendanceState[p.studentId] = p.status);

                // Close modal automatically
                const modalEl = document.getElementById('attendanceModal');
                const modalInstance = bootstrap.Modal.getInstance(modalEl);
                if (modalInstance) {
                    modalInstance.hide();
                }
                
                // Refresh the page to show updated attendance history and clear filters
                setTimeout(() => {
                    window.location.href = '/Attendance/Index';
                }, 500);
            } else {
                alert('Failed to save attendance.');
                // Keep modal open
            }
        })
        .catch(err => {
            console.error(err);
            alert('Failed to save attendance.');
            // Keep modal open
        });
    });

    // Handle View Attendance Details button clicks
    document.querySelectorAll('.view-attendance-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            const date = this.dataset.date;
            const sectionId = this.dataset.sectionId;
            
            // Show loading spinner
            const contentDiv = document.getElementById('attendanceDetailsContent');
            contentDiv.innerHTML = `
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            `;
            
            // Fetch attendance details
            fetch(`/Attendance/GetAttendanceDetails?date=${date}&sectionId=${sectionId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        let html = `
                            <div class="mb-3">
                                <h6 class="fw-bold">Date: ${data.date}</h6>
                                <h6 class="fw-bold">Teacher: ${data.teacherName}</h6>
                                <h6 class="fw-bold">Subject: ${data.sectionName}</h6>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Student Name</th>
                                            <th class="text-center">Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                        `;
                        
                        data.attendance.forEach(student => {
                            html += `
                                <tr>
                                    <td>${student.studentName}</td>
                                    <td class="text-center">
                                        <span class="badge bg-${student.statusClass}">
                                            ${student.status}
                                        </span>
                                    </td>
                                </tr>
                            `;
                        });
                        
                        html += `
                                    </tbody>
                                </table>
                            </div>
                        `;
                        
                        contentDiv.innerHTML = html;
                    } else {
                        contentDiv.innerHTML = `
                            <div class="alert alert-danger">
                                ${data.message || 'Failed to load attendance details.'}
                            </div>
                        `;
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    contentDiv.innerHTML = `
                        <div class="alert alert-danger">
                            Failed to load attendance details. Please try again.
                        </div>
                    `;
                });
        });
    });

    // Automatically open modal if students are loaded
    window.addEventListener('DOMContentLoaded', () => {
        // Trigger teacher filter on page load for admin
        const teacherSelect = document.getElementById('teacherSelect');
        if (teacherSelect) {
            teacherSelect.dispatchEvent(new Event('change'));
        }
        
    @* Only trigger if we have a date selected AND we didn't just save *@
    @if (ViewBag.SelectedDate != null && !justSaved)
    {
        <text>
                    var attendanceModal = new bootstrap.Modal(document.getElementById('attendanceModal'));
                    attendanceModal.show();
        </text>
    }
    });
</script>