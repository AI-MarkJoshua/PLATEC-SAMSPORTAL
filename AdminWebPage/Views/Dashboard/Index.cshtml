@{
    ViewData["Title"] = "Dashboard";
    var data = ViewBag.ChartData;
    var userRole = Context.Session.GetString("UserRole");
}

<h2 class="mb-4">Dashboard</h2>

<!-- SUMMARY CARDS -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card summary-card p-3 shadow-sm d-flex flex-row align-items-center"
             style="--accent-color:#9579e1; --accent-color-light:#b49ee7;">

            <!-- ICON -->
            <div class="me-3 summary-icon">
                <i class="bi bi-people-fill"></i>
            </div>

            <!-- TEXT -->
            <div class="text-start">
                <h6 class="mb-1">Total Students</h6>
                <h3 class="mb-0">@ViewBag.TotalStudents</h3>
            </div>
        </div>
    </div>


    <div class="col-md-3">
        <div class="card summary-card p-3 shadow-sm d-flex flex-row align-items-center"
             style="--accent-color:#3667c7; --accent-color-light:#3d8ef7;">

            <div class="me-3 summary-icon">
                <i class="bi bi-person-badge-fill"></i>
            </div>

            <div class="text-start">
                <h6 class="mb-1">Total Teachers</h6>
                <h3 class="mb-0">@ViewBag.TotalTeachers</h3>
            </div>
        </div>
    </div>

    @if (userRole == "Admin")
    {
        <div class="col-md-3">
            <div class="card summary-card p-3 shadow-sm d-flex flex-row align-items-center"
                 style="--accent-color:#ff6b6b; --accent-color-light:#ff8787;">

                <div class="me-3 summary-icon">
                    <i class="bi bi-book-fill"></i>
                </div>

                <div class="text-start">
                    <h6 class="mb-1">Total Subjects</h6>
                    <h3 class="mb-0">@ViewBag.TotalSubjects</h3>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="col-md-3">
            <div class="card summary-card p-3 shadow-sm d-flex flex-row align-items-center"
                 style="--accent-color:#1f9e4b; --accent-color-light:#54d261;">

                <div class="me-3 summary-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>

                <div class="text-start">
                    <h6 class="mb-1">Present Today</h6>
                    <h3 class="mb-0">@ViewBag.PresentToday</h3>
                </div>
            </div>
        </div>
    }

    @if (userRole == "Admin")
    {
        <div class="col-md-3">
            <div class="card summary-card p-3 shadow-sm d-flex flex-row align-items-center"
                 style="--accent-color:#4ecdc4; --accent-color-light:#6ee7df;">

                <div class="me-3 summary-icon">
                    <i class="bi bi-clipboard-data-fill"></i>
                </div>

                <div class="text-start">
                    <h6 class="mb-1">Total Attendance Created</h6>
                    <h3 class="mb-0">@ViewBag.TotalAttendanceCreated</h3>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="col-md-3">
            <div class="card summary-card p-3 shadow-sm d-flex flex-row align-items-center"
                 style="--accent-color:#f55e5f; --accent-color-light:#f78485;">

                <div class="me-3 summary-icon">
                    <i class="bi bi-x-circle-fill"></i>
                </div>

                <div class="text-start">
                    <h6 class="mb-1">Absent Today</h6>
                    <h3 class="mb-0">@ViewBag.AbsentToday</h3>
                </div>
            </div>
        </div>
    }

</div>

<!-- VIEW SWITCH -->
<div class="mb-3">
    <a class="btn btn-outline-primary btn-sm" href="?view=daily">Daily</a>
    <a class="btn btn-outline-secondary btn-sm" href="?view=weekly">Weekly</a>
</div>

<!-- ATTENDANCE CHART -->
<div class="card chart-card shadow-sm">
    <canvas id="attendanceChart" height="510"></canvas> <!-- increased from 120 to 200 -->
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const chartData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(data));

    const labels = chartData.map(x => x.Date);
    const present = chartData.map(x => x.Present);
    const absent = chartData.map(x => x.Absent);
    const late = chartData.map(x => x.Late);

    new Chart(document.getElementById('attendanceChart'), {
        type: 'bar',
        data: {
            labels,
            datasets: [
                { label:'Present', data: present, backgroundColor:'#1f9e4b', borderRadius:6, barThickness:18 },
                { label:'Absent', data: absent, backgroundColor:'#f55e5f', borderRadius:6, barThickness:18 },
                { label:'Late', data: late, backgroundColor:'#ffc107', borderRadius:6, barThickness:18 }
            ]
        },
        options: {
            responsive:true,
            plugins: {
                legend:{ position:'top', labels:{ color:'#20274a', boxWidth:12, font:{ size:12, weight:'500' } } },
                tooltip:{ backgroundColor:'#20274a', titleColor:'#fff', bodyColor:'#fff', padding:10, cornerRadius:6 }
            },
            scales: {
                x:{ grid:{ display:false }, ticks:{ color:'#6c757d' } },
                y:{ beginAtZero:true, grid:{ color:'#f0f2f5' }, ticks:{ color:'#6c757d' } }
            }
        }
    });
</script>