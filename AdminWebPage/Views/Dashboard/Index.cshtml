@{
    ViewData["Title"] = "Dashboard";
    var data = ViewBag.ChartData;
    var userRole = Context.Session.GetString("UserRole");
}

<h2 class="mb-4">Dashboard</h2>

<!-- SUMMARY CARDS -->
<div class="row mb-4">
    @if (userRole == "Admin")
    {
        <div class="col-md-3">
            <div class="card summary-card p-3 shadow-sm d-flex flex-row align-items-center"
                 style="--accent-color: #20274a; --accent-color-light: #6b7aa1;">

                <div class="me-3 summary-icon">
                    <i class="bi bi-people-fill"></i>
                </div>

                <div class="text-start">
                    <h6 class="mb-1">Total Students</h6>
                    <h3 class="mb-0">@ViewBag.TotalStudents</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card summary-card p-3 shadow-sm d-flex flex-row align-items-center"
                 style="--accent-color: #20274a; --accent-color-light: #6b7aa1;">

                <div class="me-3 summary-icon">
                    <i class="bi bi-person-badge-fill"></i>
                </div>

                <div class="text-start">
                    <h6 class="mb-1">Total Teachers</h6>
                    <h3 class="mb-0">@ViewBag.TotalTeachers</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card summary-card p-3 shadow-sm d-flex flex-row align-items-center"
                 style="--accent-color: #20274a; --accent-color-light: #6b7aa1;">

                <div class="me-3 summary-icon">
                    <i class="bi bi-book-fill"></i>
                </div>

                <div class="text-start">
                    <h6 class="mb-1">Total Subjects</h6>
                    <h3 class="mb-0">@ViewBag.TotalSubjects</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card summary-card p-3 shadow-sm d-flex flex-row align-items-center"
                 style="--accent-color: #20274a; --accent-color-light: #6b7aa1;">

                <div class="me-3 summary-icon">
                    <i class="bi bi-clipboard-data-fill"></i>
                </div>

                <div class="text-start">
                    <h6 class="mb-1">Total Attendance Created</h6>
                    <h3 class="mb-0">@ViewBag.TotalAttendanceCreated</h3>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="col-md-3">
            <div class="card summary-card p-3 shadow-sm d-flex flex-row align-items-center"
                 style="--accent-color: #20274a; --accent-color-light: #6b7aa1;">

                <div class="me-3 summary-icon">
                    <i class="bi bi-people-fill"></i>
                </div>

                <div class="text-start">
                    <h6 class="mb-1">Total Students</h6>
                    <h3 class="mb-0">@ViewBag.TotalStudents</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card summary-card p-3 shadow-sm d-flex flex-row align-items-center"
                 style="--accent-color: #20274a; --accent-color-light: #6b7aa1;">

                <div class="me-3 summary-icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>

                <div class="text-start">
                    <h6 class="mb-1">Present Today</h6>
                    <h3 class="mb-0">@ViewBag.PresentToday</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card summary-card p-3 shadow-sm d-flex flex-row align-items-center"
                 style="--accent-color: #20274a; --accent-color-light: #6b7aa1;">

                <div class="me-3 summary-icon">
                    <i class="bi bi-x-circle-fill"></i>
                </div>

                <div class="text-start">
                    <h6 class="mb-1">Absent Today</h6>
                    <h3 class="mb-0">@ViewBag.AbsentToday</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card summary-card p-3 shadow-sm d-flex flex-row align-items-center"
                 style="--accent-color: #20274a; --accent-color-light: #6b7aa1;">

                <div class="me-3 summary-icon">
                    <i class="bi bi-clock-fill"></i>
                </div>

                <div class="text-start">
                    <h6 class="mb-1">Late Today</h6>
                    <h3 class="mb-0">@ViewBag.LateToday</h3>
                </div>
            </div>
        </div>
    }
</div>

<!-- ATTENDANCE CHART -->
<div class="card chart-card shadow-sm p-4" style="max-height: 350px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0 fw-bold">Attendance Overview</h5>
        <span class="fw-bold position-absolute start-50 translate-middle-x" style="font-size: 14px; color: #20274a;">
            @if (ViewBag.ViewType == "weekly")
            {
                var weekStart = DateTime.Today.AddDays(-6);
                var weekEnd = DateTime.Today;
                @:@weekStart.ToString("MMM dd") - @weekEnd.ToString("MMM dd, yyyy")
            }
            else
            {
                @:@DateTime.Today.ToString("MMMM dd, yyyy")
            }
        </span>
        <div class="btn-group btn-group-sm" role="group">
            <a class="btn btn-outline-primary @(ViewBag.ViewType == "daily" ? "active-view" : "")" href="?view=daily" 
               style="color: #e2c388; border-color: #e2c388; @(ViewBag.ViewType == "daily" ? "background-color: #e2c388; color: white;" : "")"
               onmouseover="this.style.backgroundColor='#e2c388'; this.style.color='white';"
               onmouseout="@(ViewBag.ViewType == "daily" ? "" : "this.style.backgroundColor='transparent'; this.style.color='#e2c388';")">Daily</a>
            <a class="btn btn-outline-secondary @(ViewBag.ViewType == "weekly" ? "active-view" : "")" href="?view=weekly" 
               style="color: #e2c388; border-color: #e2c388; @(ViewBag.ViewType == "weekly" ? "background-color: #e2c388; color: white;" : "")"
               onmouseover="this.style.backgroundColor='#e2c388'; this.style.color='white';"
               onmouseout="@(ViewBag.ViewType == "weekly" ? "" : "this.style.backgroundColor='transparent'; this.style.color='#e2c388';")">Weekly</a>
        </div>
    </div>
    <div style="height: 250px; position: relative;">
        <canvas id="attendanceChart"></canvas>
    </div>
</div>

<style>
.active-view {
    background-color: #e2c388 !important;
    color: white !important;
}
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const chartData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(data));
    const userRole = '@userRole';

    let labels, present, absent, late;
    
    if (userRole === 'Teacher') {
        // Teacher sees student names with separate bars
        labels = chartData.map(x => x.StudentName);
        present = chartData.map(x => x.Present);
        absent = chartData.map(x => x.Absent);
        late = chartData.map(x => x.Late);
    } else {
        // Admin sees subject-based data
        labels = chartData.map(x => x.Subject);
        present = chartData.map(x => x.Present);
        absent = chartData.map(x => x.Absent);
        late = chartData.map(x => x.Late);
    }

    new Chart(document.getElementById('attendanceChart'), {
        type: 'bar',
        data: {
            labels,
            datasets: [
                { 
                    label:'Present', 
                    data: present, 
                    backgroundColor: '#6b7aa1', // Lighter shade of #20274a
                    borderColor: '#5a6a91',
                    borderWidth: 1,
                    borderRadius: 6,
                    barThickness: 'flex',
                    maxBarThickness: 25
                },
                { 
                    label:'Absent', 
                    data: absent, 
                    backgroundColor: '#20274a', // Dark color
                    borderColor: '#1a1f3a',
                    borderWidth: 1,
                    borderRadius: 6,
                    barThickness: 'flex',
                    maxBarThickness: 25
                },
                { 
                    label:'Late', 
                    data: late, 
                    backgroundColor: '#e2c388', // Yellow-ish
                    borderColor: '#d4b374',
                    borderWidth: 1,
                    borderRadius: 6,
                    barThickness: 'flex',
                    maxBarThickness: 25
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            devicePixelRatio: window.devicePixelRatio || 1,
            plugins: {
                legend: { 
                    position: 'top', 
                    labels: { 
                        color: '#20274a', 
                        boxWidth: 12, 
                        font: { size: 12, weight: '500' },
                        padding: 15,
                        usePointStyle: true,
                        pointStyle: 'rectRounded'
                    } 
                },
                tooltip: { 
                    backgroundColor: '#20274a', 
                    titleColor: '#fff', 
                    bodyColor: '#fff', 
                    padding: 10, 
                    cornerRadius: 6,
                    boxPadding: 3,
                    titleFont: { weight: '600', size: 13 },
                    bodyFont: { size: 12 },
                    callbacks: {
                        label: function(context) {
                            const label = context.dataset.label;
                            const value = context.parsed.y;
                            const unit = userRole === 'Teacher' ? ' days' : ' students';
                            return label + ': ' + value + unit;
                        }
                    }
                }
            },
            scales: {
                x: { 
                    stacked: userRole === 'Admin', // Only stack for admin
                    grid: { display: false }, 
                    ticks: { 
                        color: '#6c757d',
                        font: { size: 11 },
                        maxRotation: userRole === 'Teacher' ? 45 : 0,
                        minRotation: 0
                    } 
                },
                y: { 
                    beginAtZero: true,
                    stacked: userRole === 'Admin', // Only stack for admin
                    grid: { 
                        color: '#f0f2f5',
                        drawBorder: false
                    }, 
                    ticks: { 
                        color: '#6c757d',
                        font: { size: 11 },
                        stepSize: 1,
                        precision: 0
                    } 
                }
            },
            interaction: {
                mode: 'index',
                intersect: false
            },
            animation: {
                duration: 800,
                easing: 'easeInOutQuart'
            }
        }
    });
</script>