@model AdminWebPage.Shared.Models.Section

@{
    ViewData["Title"] = "Add Subject";
}

<h2 class="mb-4">Add New Subject</h2>

<div class="row justify-content-center">
    <div class="col-md-6">

        <form asp-action="Create" class="bg-white p-4 rounded-20 shadow-sm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="SectionName" class="form-label">Subject Name</label>
                <input asp-for="SectionName" class="form-control rounded-20" 
                       placeholder="Enter subject name (e.g., English, Math, Science, Filipino)" />
                <span asp-validation-for="SectionName" class="text-danger"></span>
                <small class="text-muted d-block mt-1">
                    Choose a name for this subject (e.g., English, Math, Science, Filipino)
                </small>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light rounded-20">
                    Cancel
                </a>
                <button type="submit" class="btn text-white rounded-20" 
                        style="background-color:#20274a;">
                    <i class="bi bi-plus-circle"></i> Create Subject
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
