@model IEnumerable<AdminWebPage.Shared.Models.Section>

@{
    ViewData["Title"] = "Classroom Management";
}

<h2 class="mb-4">Classroom Management</h2>

<div class="row justify-content-center">
    <div class="col-md-10">

        <!-- Create Button -->
        <div class="row mb-3">
            <div class="col-md-12">
                <a asp-action="Create" class="btn text-white rounded-20" style="background-color:#20274a;">
                    <i class="bi bi-plus-circle"></i> Add New Classroom
                </a>
            </div>
        </div>

        <!-- Sections List -->
        <div class="bg-white rounded-20 shadow-sm p-4">
            @if (!Model.Any())
            {
                <div class="text-center py-4">
                    <i class="bi bi-inbox fs-1 text-muted"></i>
                    <p class="text-muted mt-2">No classrooms found. Create your first classroom!</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Classroom Name</th>
                                <th>Created Date</th>
                                <th>Assigned Teachers</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.SectionName</strong>
                                    </td>
                                    <td>
                                        @item.CreatedAt.ToString("MMM dd, yyyy")
                                    </td>
                                    <td>
                                        @{
                                            var teacherCount = item.TeacherSections?.Count ?? 0;
                                            if (teacherCount > 0)
                                            {
                                                var teacherNames = item.TeacherSections
                                                    .Select(ts => ts.Teacher.FName + " " + ts.Teacher.LName)
                                                    .ToList();
                                                <span class="badge bg-success rounded-20">
                                                    @string.Join(", ", teacherNames)
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary rounded-20">No teachers</span>
                                            }
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Edit" asp-route-id="@item.SectionID" 
                                           class="btn btn-sm btn-outline-primary rounded-20 me-2">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.SectionID" 
                                           class="btn btn-sm btn-outline-danger rounded-20">
                                            <i class="bi bi-trash"></i> Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Back Button -->
        <div class="row mt-3">
            <div class="col-md-12">
                <a asp-controller="Dashboard" asp-action="Index" 
                   class="btn btn-light rounded-20">
                    <i class="bi bi-arrow-left"></i> Back to Dashboard
                </a>
            </div>
        </div>

    </div>
</div>
