@model AdminWebPage.Shared.Models.Section

@{
    ViewData["Title"] = "Edit Classroom";
}

<h2 class="mb-4">Edit Classroom</h2>

<div class="row justify-content-center">
    <div class="col-md-6">

        <form asp-action="Edit" class="bg-white p-4 rounded-20 shadow-sm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="SectionID" />

            <div class="mb-4">
                <label asp-for="SectionName" class="form-label">Classroom Name</label>
                <input asp-for="SectionName" class="form-control rounded-20" 
                       placeholder="Enter classroom name (e.g., Apple, Banana, etc.)" />
                <span asp-validation-for="SectionName" class="text-danger"></span>
                <small class="text-muted d-block mt-1">
                    Update the name for this classroom
                </small>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light rounded-20">
                    Cancel
                </a>
                <button type="submit" class="btn text-white rounded-20" 
                        style="background-color:#20274a;">
                    <i class="bi bi-pencil"></i> Update Classroom
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
